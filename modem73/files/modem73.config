config modem73 'main'
	# Set to 1 once you have configured your callsign, audio device and PTT.
	option enabled '0'

	option callsign 'N0CALL'

	# KISS TCP listener. Bind to your LAN address (or 0.0.0.0) if other
	# machines need to reach the TNC; 127.0.0.1 keeps it local.
	option port '8001'
	option bind '0.0.0.0'

	# JSON control port. Set port to 0 to disable it entirely.
	option control_port '8073'
	option control_bind '127.0.0.1'

	# Audio device. Run `modem73 --list-audio` on the router to see names.
	# Leave empty for the system default.
	option device ''
	option tx_level '100'

	# ofdm | robust | mfsk
	option modem 'ofdm'
	option modulation 'QPSK'
	option rate '1/2'
	# option robust_mode 'RDM-600'
	# option mfsk_mode 'MFSK-16'

	# Each modem family runs its own always-on receiver. A Pi 4B can
	# normally carry all of them; set these to 1 to shed CPU if needed.
	option no_mfsk_rx '0'
	option no_robust_rx '0'
	option no_ofdm_rx '0'

	# none | rigctl | vox | com
	option ptt 'none'
	# option rigctl '127.0.0.1:4532'
	# option com_port '/dev/ttyACM0'
	# option com_line 'rts'

	# CSMA carrier sense: threshold | sync | ranked, band hf | vhf
	# preset: bench | relaxed | moderate | busy
	option csma_mode 'sync'
	option csma_band 'vhf'
	option csma_preset 'moderate'

	# Anything else you want appended verbatim to the command line.
	option extra_args ''
